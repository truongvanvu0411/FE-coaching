# Production environment for the EC2 deploy. Copy to .env on the instance.
# DATABASE_URL and NEXTAUTH_URL are set by docker-compose.prod.yml — do not
# duplicate them here.

APP_DOMAIN="fe-coach.cjp-demo.online"

# Postgres password for the containerised database. Generate a fresh one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=""

# Must be a NEW secret, never the dev value — rotating it invalidates all
# existing sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Caddy terminates TLS, so next-auth sees an http origin behind a proxy.
AUTH_TRUST_HOST="true"

# Anyone who can reach /register can create an account, and every account can
# spend DeepSeek credit through /api/tutor. Leave this unset unless you want the
# site open; /api/auth/register returns 403 while it is off.
ALLOW_REGISTRATION="false"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
