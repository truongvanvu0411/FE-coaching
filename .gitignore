# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the templates. These carry no values, and the deploy runbook tells
# you to copy .env.production.example on the host — it has to actually be there.
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Runtime and generated data, not source. storage/ alone is 498 MB of OCR
# inputs and rendered review pages; the app reads it from a mounted volume, and
# these files are regenerated by the scripts/ipa-* pipeline, never edited by hand.
/storage
/.tmp
/test-results
/playwright-report
/candidates-*
/ocr-*
*.traineddata

# deploy key material — never commit
/deploy/*.pem

# Vendored AI-tooling skill bundles — three identical copies of the same Prisma
# docs (1.3 MB), reinstallable and not project source. launch.json is kept: it
# is the real dev-server definition.
/.agents
/.windsurf
/.claude/skills
